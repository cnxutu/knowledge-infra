services:
  mysql:
    image: docker.1ms.run/mysql:5.7
    container_name: mysql
    ports:
      - 3306:3306
    volumes:
      - ./mysql/data:/var/lib/mysql
      - ./mysql/log:/var/log/mysql
      - ./mysql/mysql.cnf:/etc/mysql/conf.d/mysql.cnf
      - ./mysql/initdb:/docker-entrypoint-initdb.d
    environment:
      MYSQL_DATABASE: star-pro-base-cloud
      MYSQL_ROOT_PASSWORD: admin123
    command:
      [
        'mysqld',
        '--character-set-server=utf8mb4',
        '--collation-server=utf8mb4_unicode_ci',
        '--default-time-zone=+8:00',
        '--lower-case-table-names=1'
      ]
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "1024m"
        max-file: "3"
    healthcheck:
      test: [ "CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "--password=admin123" ]
      interval: 20s
      timeout: 10s
      retries: 3
      start_period: 40s

  nacos:
    image: docker.1ms.run/nacos/nacos-server:v2.5.1
    container_name: nacos
    ports:
      - 8848:8848
      - 9848:9848
    volumes:
      - ./nacos/data:/home/nacos/data
      - ./nacos/logs:/home/nacos/logs
    environment:
      MODE: standalone
      NACOS_AUTH_ENABLE: true  # 启用鉴权
      NACOS_AUTH_TOKEN: "VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg="  # 添加 Token
      NACOS_AUTH_IDENTITY_KEY: "nacos"  # 设置身份标识 Key
      NACOS_AUTH_IDENTITY_VALUE: "zjyyxy123$%^" # 设置身份标识 Value
      SPRING_DATASOURCE_PLATFORM: mysql
      MYSQL_SERVICE_HOST: mysql
      MYSQL_SERVICE_PORT: 3306
      MYSQL_SERVICE_DB_NAME: nacos
      MYSQL_SERVICE_USER: root
      MYSQL_SERVICE_PASSWORD: admin123
    depends_on:
      - mysql
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
    healthcheck:
      test: [ "CMD", "curl", "-sf", "http://localhost:8848/nacos/actuator/health" ]
      interval: 20s
      timeout: 10s
      retries: 3
      start_period: 60s

  nginx:
    image: docker.1ms.run/nginx:stable
    container_name: nginx
    ports:
      - 80:80
    volumes:
      - ./nginx/html:/usr/share/nginx/html:ro
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf
      - ./nginx/log:/var/log/nginx
    restart: always
    extra_hosts:
      - "host.docker.internal:host-gateway"
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "2"
    healthcheck:
      test: [ "CMD", "curl", "-sf", "http://localhost/" ]
      interval: 20s
      timeout: 5s
      retries: 2
      start_period: 10s

  redis:
    image: docker.1ms.run/redis:7.4.3
    container_name: redis_star_pro_base_cloud
    ports:
      - 6379:6379
    volumes:
      - ./redis/data:/data
      - ./redis/logs:/logs
      - ./redis/conf:/usr/local/etc/redis/
    command: [ '--requirepass admin123' ]
    restart: always
    healthcheck:
      test: [ "CMD", "redis-cli", "-a", "admin123", "ping" ]
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 10s

  rocketmq-namesrv:
    image: docker.1ms.run/apache/rocketmq:5.1.4
    container_name: local-rocketmq-namesrv
    ports:
      - "9876:9876"
    volumes:
      - ./rocketmq/data/namesrv/logs:/home/rocketmq/logs
    command: sh mqnamesrv
    environment:
      JAVA_OPT_EXT: "-server -Xms512m -Xmx512m -Xmn256m"
    networks:
      - rocketmq-net
    restart: always
    healthcheck:
      test: >
        bash -c '
          /home/rocketmq/rocketmq-5.1.4/bin/mqadmin clusterList -n localhost:9876 >/dev/null 2>&1
        '
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 30s

  rocketmq-broker:
    image: docker.1ms.run/apache/rocketmq:5.1.4
    container_name: local-rocketmq-broker
    ports:
      - "10911:10911"
      - "10909:10909"
    depends_on:
      - rocketmq-namesrv
    volumes:
      - ./rocketmq/data/broker/logs:/home/rocketmq/logs
      - ./rocketmq/data/broker/store:/home/rocketmq/store
      - ./rocketmq/broker.conf:/home/rocketmq/broker.conf
    command: sh mqbroker -n rocketmq-namesrv:9876 -c /home/rocketmq/broker.conf
    environment:
      JAVA_OPT_EXT: "-server -Xms1g -Xmx1g -Xmn512m"
    networks:
      - rocketmq-net
    restart: always
    healthcheck:
      test: >
        bash -c '
          /home/rocketmq/rocketmq-5.1.4/bin/mqadmin brokerStatus
          -n rocketmq-namesrv:9876
          -b $$HOSTNAME:10911
          >/dev/null 2>&1
        '
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 40s

  rocketmq-console:
    image: docker.1ms.run/apacherocketmq/rocketmq-dashboard:1.0.0
    container_name: local-rocketmq-console
    ports:
      - "6060:8080"
    environment:
      JAVA_OPTS: "-Drocketmq.namesrv.addr=rocketmq-namesrv:9876 -Dcom.rocketmq.sendMessageWithVIPChannel=false"
    depends_on:
      - rocketmq-namesrv
      - rocketmq-broker
    networks:
      - rocketmq-net
    healthcheck:
      test: [ "CMD", "curl", "-sf", "http://localhost:8080" ]
      interval: 20s
      timeout: 10s
      retries: 3
      start_period: 30s

  emqx:
    image: docker.1ms.run/emqx/emqx:5.8
    container_name: emqx5
    restart: unless-stopped
    environment:
      # =============== 节点配置 ===============
      EMQX_NODE__NAME: emqx@127.0.0.1
      EMQX_NODE__COOKIE: emqx_secret_cookie_star
      # =============== Dashboard 账号 ===============
      EMQX_DASHBOARD__DEFAULT_USERNAME: admin
      EMQX_DASHBOARD__DEFAULT_PASSWORD: admin123
      # =============== 监听器 ===============
      EMQX_LISTENER__TCP__EXTERNAL__BIND: 0.0.0.0:1883
      EMQX_DASHBOARD__LISTENER__HTTP__BIND: 0.0.0.0:18083
      # =============== MQTT 大文件支持（关键！）===============
      EMQX_MQTT__MAX_PACKET_SIZE: 10MB   # ← 改为 10MB（支持 5MB 上报）
      EMQX_MQTT__MAX_INFLIGHT: 32
      EMQX_MQTT__MAX_QOS: 1              # QoS 2 不推荐用于大文件
      EMQX_MQTT__RETAIN_AVAILABLE: false # 大文件通常不需要 retain
      EMQTX_MQTT__SESSION_EXPIRY_INTERVAL: 2h
      EMQX_MQTT__KEEPALIVE: 120s         # 大文件传输需更长 keepalive
      # =============== 日志 ===============
      EMQX_LOG__CONSOLE__LEVEL: info
      EMQX_LOG__FILE__LEVEL: info
    volumes:
      - ./emqx/data:/opt/emqx/data   # 必须挂载：会话、离线消息等
      - ./emqx/log:/opt/emqx/log     # 可选但推荐：日志持久化
    ports:
      - "1883:1883"
      - "18083:18083"
      - "8084:8084"
    extra_hosts:
      - "host.docker.internal:host-gateway"  # 允许容器访问宿主机（WebHook 用）
    healthcheck:
      test: [ "CMD", "emqx_ctl", "status" ]
      interval: 20s
      timeout: 10s
      retries: 3
      start_period: 30s

networks:
  rocketmq-net:
    driver: bridge
